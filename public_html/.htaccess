# ============================================================
# AvtoTest Pro — Apache konfiguratsiya
# ============================================================

# PHP versiyasi
AddHandler application/x-httpd-php82 .php

# UTF-8 kodlash
AddDefaultCharset UTF-8

# ── HTTPS majburiy yo'naltirish ──────────────────────────────
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www prefiksini olib tashlash
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── Chiroyli URL'lar ─────────────────────────────────────────
RewriteRule ^login/?$            auth/login.php           [L]
RewriteRule ^register/?$         auth/register.php        [L]
RewriteRule ^forgot-password/?$  auth/forgot-password.php [L]
RewriteRule ^logout/?$           auth/logout.php          [L]
RewriteRule ^dashboard/?$        user/index.php           [L]
RewriteRule ^test/?$             user/test.php            [L]
RewriteRule ^profil/?$           user/profil.php          [L]
RewriteRule ^tolov/?$            user/payment.php         [L]
RewriteRule ^referal/?$          user/referal.php         [L]

# ── Maxfiy fayllarni himoyalash ──────────────────────────────
<FilesMatch "\.(env|sql|log|bak|swp|gitignore)$">
    Require all denied
</FilesMatch>

# Yashirin fayllar
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Tizim papkalarini bloklash
RedirectMatch 403 ^/config/
RedirectMatch 403 ^/cron/
RedirectMatch 403 ^/zaxira_nusxalari/
RedirectMatch 403 ^/lang/

# ── Xavfsizlik sarlavhalari ──────────────────────────────────
<IfModule mod_headers.c>
    # PHP versiyasini yashirish
    Header always unset X-Powered-By
    Header always unset Server

    # Clickjacking himoyasi
    Header always set X-Frame-Options "SAMEORIGIN"

    # MIME sniffing oldini olish
    Header always set X-Content-Type-Options "nosniff"

    # XSS filtr (eski brauzerlar)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer siyosati
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # HSTS — 1 yil (faqat HTTPS uchun)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Content-Security-Policy
    # 'unsafe-inline' va CDN manzillariga ruxsat (Tailwind CDN + Alpine.js + Google Fonts)
    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
        font-src 'self' https://fonts.gstatic.com; \
        img-src 'self' data: blob: https:; \
        connect-src 'self' https://api.telegram.org; \
        frame-ancestors 'self'; \
        base-uri 'self'; \
        form-action 'self'"
</IfModule>

# ── Brauzer keshi ────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp        "access plus 3 months"
    ExpiresByType image/png         "access plus 3 months"
    ExpiresByType image/jpeg        "access plus 3 months"
    ExpiresByType image/svg+xml     "access plus 1 month"
    ExpiresByType text/css          "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json  "access plus 0 seconds"
    ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ── Gzip siqish ──────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml text/xml
</IfModule>

# ── Boshqa ───────────────────────────────────────────────────
DirectoryIndex index.php

# Directory listing o'chirish
Options -Indexes

# Xato sahifalari
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php

# Katta fayllar yuklash limiti (PHP.ini ham o'zgartirilishi kerak)
<IfModule mod_php.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 8M
</IfModule>
