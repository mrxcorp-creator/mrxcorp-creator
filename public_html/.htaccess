# VatanParvar Yaypan
# DirectoryIndex birinchi navbatda
DirectoryIndex index.php index.html

Options -Indexes +FollowSymLinks
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# HTTPS majburiy
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www olib tashlash
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Chiroyli URL'lar
RewriteRule ^login/?$            auth/login.php           [L]
RewriteRule ^register/?$         auth/register.php        [L]
RewriteRule ^forgot-password/?$  auth/forgot-password.php [L]
RewriteRule ^logout/?$           auth/logout.php          [L]
RewriteRule ^dashboard/?$        user/index.php           [L]
RewriteRule ^test/?$             user/test.php            [L]
RewriteRule ^profil/?$           user/profil.php          [L]
RewriteRule ^tolov/?$            user/payment.php         [L]
RewriteRule ^referal/?$          user/referal.php         [L]
</IfModule>

<FilesMatch "\.(env|sql|log|bak|swp|gitignore)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/config/
RedirectMatch 403 ^/cron/
RedirectMatch 403 ^/zaxira_nusxalari/
RedirectMatch 403 ^/lang/

ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
