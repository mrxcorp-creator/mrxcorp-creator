# VatanParvar Yaypan

Options -Indexes +FollowSymLinks

# UTF-8
AddDefaultCharset UTF-8

# ── HTTPS majburiy ───────────────────────────────────────────
RewriteEngine On
RewriteBase /

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www olib tashlash
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── Chiroyli URL'lar ─────────────────────────────────────────
RewriteRule ^login/?$            auth/login.php           [L]
RewriteRule ^register/?$         auth/register.php        [L]
RewriteRule ^forgot-password/?$  auth/forgot-password.php [L]
RewriteRule ^logout/?$           auth/logout.php          [L]
RewriteRule ^dashboard/?$        user/index.php           [L]
RewriteRule ^test/?$             user/test.php            [L]
RewriteRule ^profil/?$           user/profil.php          [L]
RewriteRule ^tolov/?$            user/payment.php         [L]
RewriteRule ^referal/?$          user/referal.php         [L]

# ── Maxfiy fayllar ───────────────────────────────────────────
<FilesMatch "\.(env|sql|log|bak|swp|gitignore)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/config/
RedirectMatch 403 ^/cron/
RedirectMatch 403 ^/zaxira_nusxalari/
RedirectMatch 403 ^/lang/

# ── Xavfsizlik ───────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Kesh ─────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 3 months"
    ExpiresByType image/png  "access plus 3 months"
    ExpiresByType image/jpeg "access plus 3 months"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ── Gzip ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Standart
DirectoryIndex index.php
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
